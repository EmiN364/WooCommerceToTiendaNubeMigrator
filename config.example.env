# ===============================
# Credenciales de WooCommerce
# ===============================
WOOCOMMERCE_URL=https://tu-tienda.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===============================
# Credenciales de TiendaNube
# ===============================
TIENDANUBE_STORE_ID=123456
TIENDANUBE_ACCESS_TOKEN=tu_access_token_aqui
TIENDANUBE_USER_AGENT=MiApp (contacto@ejemplo.com)

# ===============================
# Opciones generales
# ===============================
DRY_RUN=true
BATCH_SIZE=10
CONCURRENCY=5
STOCK_CONCURRENCY=10
DEFAULT_STOCK_FOR_UNMANAGED=0

# ===============================
# Configuración para migrar una colección puntual
# (Puedes usar slug o ID. Solo uno es necesario)
# ===============================
TARGET_COLLECTION_SLUG=nueva-coleccion
# TARGET_COLLECTION_ID=123

